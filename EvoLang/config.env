# EvoLang 自进化语言与协议孵化器 配置文件
# ==========================================

# 加密算法
CRYPTO_ALGORITHM=aes-256-cbc

# 默认方言
DEFAULT_DIALECT=default

# 主密钥（用于派生各 Agent 的加密子密钥，留空则首次启动时自动生成）
MASTER_KEY=

# 词典演化参数
EVOLUTION_FREQUENCY_THRESHOLD=3
EVOLUTION_MERGE_THRESHOLD=0.8
MAX_DICTIONARY_SIZE=10000

# 数据存储目录（相对于插件根目录）
DATA_DIR=evolang-data

# KnowledgeBaseManager endpoint（用于向量化存储重要语言片段到 TagMemo）
# 留空则仅使用本地存储
KNOWLEDGE_BASE_ENDPOINT=
