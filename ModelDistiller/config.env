# ModelDistiller 配置文件
# ============================

# 师徒制配对关系（强模型:弱模型），多组用分号分隔
PAIR_CONFIG=gemini-2.5-pro:gemini-2.0-flash;claude-opus:claude-haiku

# 蒸馏检索参数
TOP_K_TRACES=5
SIMILARITY_THRESHOLD=0.6
MAX_CONTEXT_TOKENS=4000

# KnowledgeBaseManager / TagMemo endpoint
# 留空则使用本地文件存储（Plugin/ModelDistiller/trace-store/）
KNOWLEDGE_BASE_ENDPOINT=

# 本地轨迹存储目录（相对于插件根目录）
TRACE_STORE_DIR=trace-store
