# Open Kimi PPT VCP plugin configuration
# Relative paths are resolved from this plugin directory.
PPT_WORKSPACE_ROOT=./workspace

# Maximum size of one imported media file, in MiB.
PPT_MAX_MEDIA_MB=50

# Default local editor port.
PPT_EDITOR_PORT=55173

# Windows commonly uses python; macOS/Linux commonly uses python3.
PPT_PYTHON_COMMAND=python
