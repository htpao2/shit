# ServerProjectForge — Windows 中央服务器独立插件
# 管理员必须显式配置允许根目录。空值表示不授权，绝不表示全盘放行。
# 推荐 JSON 数组并使用正斜杠，例如：
# ALLOWED_DIRECTORIES=["D:/AgentWorkspaces","E:/Projects"]
ALLOWED_DIRECTORIES=

# 可选：已存在且位于允许根内的默认工作区。留空时由 Agent RegisterWorkspace。
DEFAULT_WORKSPACE_PATH=
DEFAULT_WORKSPACE_ALIAS=default

# 以下相对路径基于 VCPToolBox 中央服务器根目录，不基于进程当前目录。
PROJECTFORGE_DATA_DIR=AppData/ServerProjectForge
PROJECTFORGE_DB_PATH=
PROJECTFORGE_STATUS_PATH=
INDEXER_BINARY_PATH=

# 显式开启才允许 JS/Python/Rust 试跑，以及 Trace 执行工程 preload 声明表。
# 不是安全沙箱。模块导入、setup、Cargo build.rs 和被测代码都可能写盘联网。
EVAL_ENABLED=false
AST_INDEX_ENABLED=true

MAX_EDIT_FILE_SIZE=5242880
READ_MAX_FILES=20
READ_MAX_TOTAL_BYTES=31457280