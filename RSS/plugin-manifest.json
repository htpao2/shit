{
  "manifestVersion": "1.0.0",
  "name": "RSS",
  "version": "1.0.0",
  "displayName": "RSS新闻每日推送",
  "description": "每日从配置的RSS源中抓取最新简报，通过 {{VCPRSS}} 提供给系统提示词，支持动态语义折叠。",
  "author": "Kilo Code",
  "pluginType": "static",
  "entryPoint": {
    "type": "nodejs",
    "command": "node RSS.js"
  },
  "communication": {
    "protocol": "stdio",
    "timeout": 30000
  },
  "capabilities": {
    "systemPromptPlaceholders": [
      {
        "placeholder": "{{VCPRSS}}",
        "description": "每日 RSS 新闻简报，支持语义折叠。根据用户话题相关性动态展开详细概览或极简摘要。"
      }
    ]
  },
  "refreshIntervalCron": "0 6,12,18 * * *",
  "configSchema": {
    "RSS_FEED_URL": {
      "type": "string",
      "description": "RSS订阅地址",
      "default": "https://raw.githubusercontent.com/imjuya/juya-ai-daily/master/feed.xml"
    },
    "RSS_SAVE_PATH": {
      "type": "string",
      "description": "每日新闻保存的本地文件夹路径",
      "default": "./DailyNews"
    }
  }
}
