# AICodeWorker v2 / Snow CLI 配置
# 复制为 config.env。插件每个 job 都会独立启动一个 Snow SSE 前台子进程，job 结束后自动关闭。

# Snow CLI 可执行文件。先确认 `snow --version` 可用；也可填写绝对路径。
SNOW_BIN=snow

# 固定前置参数，必须是 JSON 字符串数组。通常保持 []。
# 例如直接运行源码 bundle：SNOW_BIN=node，SNOW_BIN_ARGS=["/absolute/path/bundle/cli.mjs"]
SNOW_BIN_ARGS=[]

# 允许操作的项目根目录白名单，多个路径用逗号分隔。
# projectPath 必须等于某个根目录或位于其内部；Windows 可使用 C:\Projects 形式。
ALLOWED_PROJECT_ROOTS=/app/VCPToolBox_new

# job 数据目录；包含 meta/output/logs/events。留空时默认使用插件目录下 jobs。
JOB_ROOT=

# 项目背景，会自动注入每条任务；多项目共用时建议留空。用 \n 表示换行。
PROJECT_CONTEXT=

# 单次任务最大字符数。
MAX_TASK_CHARS=20000

# Agent 执行超时（秒）与 Snow SSE 启动健康检查超时（秒）。
DEFAULT_TIMEOUT_SEC=900
SNOW_STARTUP_TIMEOUT_SEC=45

# Snow 等待工具审批或用户回答的内部超时（毫秒）。
# AICodeWorker 会立即批准非敏感工具、拒绝敏感工具；遇到用户问题则发送 cancelled 响应安全收束。
SNOW_INTERACTION_TIMEOUT_MS=300000

# 每任务 Snow SSE 动态端口范围，仅绑定 127.0.0.1。
SNOW_SSE_PORT_MIN=32100
SNOW_SSE_PORT_MAX=32999

# 全局并发硬上限。每个 Snow Agent 都可能占用较多内存，默认 1 最安全。
MAX_CONCURRENT_JOBS=1

# 历史 job 保留天数；提交和 listJobs 时渐进清理。
JOB_RETAIN_DAYS=7

# query detail=full 返回的事件转录最大字符数；超出时仅返回尾部。
FULL_TRANSCRIPT_MAX_CHARS=100000

# 对最终回复、日志和错误执行常见 API Key / Token 脱敏。
REDACT_SECRETS=true

# Snow 本身的模型、Profile、MCP、Hooks、敏感命令与权限仍由 ~/.snow 和项目 .snow 配置管理。
# AICodeWorker 不写 Snow 的 API Key，也不使用静态插件折叠协议。
