# VCP Discord Bot 配置文件示例
# 将此文件复制为 config.env 并填入实际值

# ============================================
# Discord Bot 配置（必需）
# ============================================

# Discord Bot Token（必需）
# 从 https://discord.com/developers/applications 获取
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ============================================
# VCP 集成配置
# ============================================

# 绑定的 Agent 名称（用于主动唤醒）
AgentName=AI管家

# ============================================
# 功能配置
# ============================================

# 重要频道 ID 列表（逗号分隔）
# 这些频道的消息会主动唤醒 AI
ImportantChannels=

# 保留的会话轮数（默认 8 轮）
HistoryTurns=8

# 消息队列最大容量（默认 1000）
MaxQueueSize=1000

# 折叠协议输出间隔（毫秒，默认 10000）
FoldOutputInterval=10000

# ============================================
# 自动唤醒配置
# ============================================

# 被 @ 时自动唤醒 AI（默认 true）
AutoPokeOnMention=true

# 重要频道消息自动唤醒 AI（默认 true）
AutoPokeOnImportantChannel=true

# ============================================
# 调试配置
# ============================================

# 启用调试模式（默认 false）
DebugMode=false
