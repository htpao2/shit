# AutonomousSchedulerPlugin 配置文件
# 将此文件复制为 config.env 并根据需要修改配置

# 是否启用自动调度器（true/false）
# 启用后，插件会在初始化时自动开始定期检查任务板
AUTONOMOUS_SCHEDULER_ENABLED=true

# 检查间隔（分钟）
# 调度器每隔多少分钟检查一次任务板
AUTONOMOUS_SCHEDULE_INTERVAL_MINUTES=5

# 空闲检查概率（0.0-1.0）
# 当没有任务时，以此概率执行空闲检查（检查进行中任务、过期任务等）
AUTONOMOUS_IDLE_PROBABILITY=0.2

# -------------------------------------------------------------------
# Agent技能配置
# -------------------------------------------------------------------
# 格式: AGENT_SKILLS_{AGENT_NAME}=skill1,skill2,skill3,...
# 
# 如果不配置，调度器会尝试从 AgentAssistant 的 config.env 中读取
# Agent 的 DESCRIPTION 字段并自动解析技能关键词。
#
# 示例配置（与 AgentAssistant 中的 Agent 对应）:

# AGENT_SKILLS_小娜=management,philosophy,knowledge,general,planning,coordination
# AGENT_SKILLS_小克=science,math,physics,chemistry,biology,data,calculation,programming
# AGENT_SKILLS_小吉=politics,psychology,law,history,sociology,ideology,research
# AGENT_SKILLS_小冰=acgn,meme,internet,subculture,entertainment,games
# AGENT_SKILLS_小雨=writing,copywriting,documents,letters,creative,editing
# AGENT_SKILLS_小绝=ai,prompts,models,technology,security,programming
# AGENT_SKILLS_小芸=design,art,illustration,ui,graphics,visual

# 如果使用通用版 AgentAssistant，请根据你配置的 Agent 填写技能:
# AGENT_SKILLS_ResearchBot=research,analysis,data,information,synthesis
# AGENT_SKILLS_StorySpark=creative,writing,story,character,plot
# AGENT_SKILLS_编程小能手=programming,code,debug,algorithm,development
# AGENT_SKILLS_Nova=general,assistant

# -------------------------------------------------------------------
# 默认Agent配置
# -------------------------------------------------------------------
# 当任务没有匹配到任何Agent时，使用此Agent作为默认处理者
# 填入 AgentAssistant 中配置的某个 Agent 的名称
DEFAULT_AGENT_NAME=小娜