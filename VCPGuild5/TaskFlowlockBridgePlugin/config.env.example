# TaskFlowlockBridgePlugin 配置文件
# 该插件只负责 TaskBoard 任务与 AgentAssistant delegation 的持久化映射和对账。
# Flowlock 心跳、协议解析和模型循环由官方 AgentAssistant 负责。

# 是否启用任务心流桥接服务
TASK_FLOWLOCK_BRIDGE_ENABLED=true

# 活动映射的定期对账间隔（秒）
# 有效范围：5-3600
TASK_FLOWLOCK_RECONCILE_INTERVAL_SECONDS=30

# 插件启动后首次恢复对账的延迟（秒）
# 给 TaskBoard 和 AgentAssistant 留出初始化时间；有效范围：1-3600
TASK_FLOWLOCK_RECOVERY_DELAY_SECONDS=5

# AA 委托在重启后失联，或委托完成但任务仍未提交时，允许重新提交的最大次数
# 达到上限后映射保持 orphaned，等待人工处理；有效范围：0-20
TASK_FLOWLOCK_MAX_REDISPATCHES=2

# 映射与审计数据目录（相对于插件目录）
TASK_FLOWLOCK_DATA_DIR=./data
